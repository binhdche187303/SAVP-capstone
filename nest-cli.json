{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [{ "include": "assets/fonts/*.ttf", "outDir": "dist" }, { "include": "assets/report-templates/*.png", "outDir": "dist" }],
    "watchAssets": true
  }
}
