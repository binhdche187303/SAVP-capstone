# =============================================================================
# CAPSTONE Backend — Environment Variables (EXAMPLE / TEMPLATE)
# Copy sang `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Mọi secret ở đây là PLACEHOLDER — thay bằng giá trị thật ở local/prod.
# =============================================================================

# ─── A. Application ──────────────────────────────────────────────────────────
APP_PORT=3000
APP_NAME=capstone-be
APP_URL=http://localhost:3000
API_PREFIX=api
APP_TIMEZONE=Asia/Ho_Chi_Minh
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001
# Trang docs Swagger/OpenAPI (/api/docs) — tắt (false) nếu không muốn phơi ra public
SWAGGER_ENABLED=true

# ─── B. Database ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=capstone_db
DB_SCHEMA=public
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_MIGRATIONS_RUN=true

# ─── C. Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=capstone:
REDIS_TTL_DEFAULT=600

# ─── D. JWT / Auth ───────────────────────────────────────────────────────────
# Sinh secret ngẫu nhiên đủ mạnh, ví dụ: openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=change_me_access_secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_SECRET=change_me_refresh_secret
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_JWT_ISSUER=capstone-be
AUTH_JWT_AUDIENCE=capstone-client
AUTH_JWT_BLACKLIST_PREFIX=auth:blacklist:jti:
WARNING_TOKEN_SECRET=change_me_warning_secret

# ─── E. OTP ──────────────────────────────────────────────────────────────────
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_LENGTH=6
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_RESENDS=5
AUTH_OTP_MAX_VERIFY_ATTEMPTS=5
AUTH_OTP_PREFIX=auth:otp:password-reset:

# ─── E1. Guest Access (feat-external-guest-live-meeting-access, GLA-001) ──────
# BẮT BUỘC — phải KHÁC AUTH_ACCESS_TOKEN_SECRET/AUTH_REFRESH_TOKEN_SECRET (min 16 ký tự)
GUEST_TOKEN_SECRET=change_me_guest_secret_at_least_16_characters_long
GUEST_ACCESS_OTP_TTL_SECONDS=600
GUEST_ACCESS_OTP_MAX_RESENDS=3
GUEST_ACCESS_OTP_RESEND_WINDOW_SECONDS=300
GUEST_ACCESS_OTP_MAX_VERIFY_ATTEMPTS=5
GUEST_ACCESS_OTP_BLOCK_SECONDS=900
GUEST_ACCESS_SESSION_MAX_HOURS=4
GUEST_ACCESS_JOIN_WINDOW_BEFORE_MINUTES=30
GUEST_ACCESS_JOIN_WINDOW_AFTER_MINUTES=15
GUEST_ACCESS_INVITE_LINK_TTL_HOURS=24
# URL trang FE xử lý magic link — BE ghép thành <base>/<epId>.<secret>
GUEST_ACCESS_INVITE_BASE_URL=http://localhost:5173/guest/join
GUEST_ACCESS_DEVICE_REMEMBER_DAYS=30
GUEST_ACCESS_LOBBY_ENABLED_DEFAULT=true
GUEST_ACCESS_VERIFICATION_MODE_DEFAULT=otp

# ─── F. Rate Limit ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_OTP_REQUEST_RATE_LIMIT_MAX_ATTEMPTS=3
AUTH_OTP_REQUEST_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_OTP_VERIFY_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=300

# ─── G. BullMQ Queue ─────────────────────────────────────────────────────────
BULL_REDIS_HOST=localhost
BULL_REDIS_PORT=6379
BULL_REDIS_PASSWORD=
BULL_REDIS_DB=1
BULL_QUEUE_PREFIX=capstone
BULL_DEFAULT_ATTEMPTS=3
BULL_DEFAULT_BACKOFF_DELAY_MS=5000
BULL_REMOVE_ON_COMPLETE=true
BULL_REMOVE_ON_FAIL=false
QUEUE_AUTH=auth
QUEUE_NOTIFICATION=notification
QUEUE_ACCOUNT_IMPORT=account-import
QUEUE_MEDIA_PROCESSING=media-processing
QUEUE_TRANSCRIPTION=transcription
QUEUE_REPORT_EXPORT=report-export
QUEUE_MINUTES_EXPORT=minutes-export
QUEUE_SCHEDULER=scheduler
# MKM-AI-01: queue AI draft meeting minutes (LLM summarize)
QUEUE_MINUTES_AI_DRAFT=minutes.generate_ai_draft

# ─── H. Notification ─────────────────────────────────────────────────────────
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_IN_APP_ENABLED=true
NOTIFICATION_WEBSOCKET_ENABLED=true
NOTIFICATION_DEFAULT_CHANNEL=email
NOTIFICATION_RETRY_ATTEMPTS=3

# ─── I. Storage / Media Files ────────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads
STORAGE_MAX_FILE_SIZE=104857600
# S3/MinIO (optional — chỉ dùng khi STORAGE_DRIVER=s3)
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_BUCKET=capstone-media
STORAGE_S3_ACCESS_KEY=change_me
STORAGE_S3_SECRET_KEY=change_me
# Bug #1 (2026-07-29): chỉ hostname/IP, KHÔNG kèm port — cổng khai riêng ở
# STORAGE_S3_PORT. Ghi kèm port (VD "http://x.x.x.x:9000") sẽ dính lỗi
# "Invalid endPoint" khi MinIO SDK khởi tạo client.
STORAGE_S3_ENDPOINT=localhost
STORAGE_S3_PORT=9000
STORAGE_S3_USE_SSL=false
STORAGE_S3_FORCE_PATH_STYLE=true

# ─── J. WebSocket ────────────────────────────────────────────────────────────
WS_ENABLED=true
WS_PATH=/ws
WS_CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3001
WS_HEARTBEAT_INTERVAL_MS=30000
WS_AUTH_REQUIRED=true

# ─── K. Scheduler ────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
SCHEDULER_NO_SHOW_CHECK_ENABLED=false
SCHEDULER_NO_SHOW_CHECK_CRON=*/5 * * * *
SCHEDULER_AUTO_RELEASE_ENABLED=false
SCHEDULER_AUTO_RELEASE_CRON=*/5 * * * *
# EVD-001: cron phát hiện phòng trống sớm (gated default OFF)
SCHEDULER_EARLY_VACANCY_ENABLED=false
# recon B1: cron auto-complete meeting quá end_time (gated default OFF)
# ⚠ Bị thay thế bởi SCHEDULER_MEETING_STATUS_ENABLED bên dưới — chỉ giữ cho env cũ.
SCHEDULER_AUTO_COMPLETE_ENABLED=false
# F-A (MST-001): cron mỗi phút lật meetings.status theo thời gian
# (scheduled→in_progress khi tới giờ, →completed khi quá giờ). Gated default OFF.
# Cần BẬT để check-in khuôn mặt IVSS khớp được cuộc họp và báo cáo 'completed' có dữ liệu.
SCHEDULER_MEETING_STATUS_ENABLED=false
# IPS-001 (#37): cron đồng bộ person IVSS (gated default OFF)
SCHEDULER_IVSS_SYNC_ENABLED=false
SCHEDULER_NOTIFICATION_REMINDER_ENABLED=false
SCHEDULER_NOTIFICATION_REMINDER_CRON=0 * * * *

# ─── L. System Config Cache ──────────────────────────────────────────────────
SYSTEM_CONFIG_CACHE_ENABLED=true
SYSTEM_CONFIG_CACHE_TTL_SECONDS=300

# ─── M. Audit Log ────────────────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FAIL_SAFE=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_INCLUDE_REQUEST_BODY=false
AUDIT_LOG_INCLUDE_RESPONSE_BODY=false

# ─── N. Health Check ─────────────────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_DB=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_QUEUE=true
HEALTH_CHECK_STORAGE=true
HEALTH_DISK_THRESHOLD_PERCENT=90

# ─── O. Seed ─────────────────────────────────────────────────────────────────
SEED_RUN_ON_STARTUP=false
SEED_ADMIN_EMAIL=admin@capstone.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULL_NAME=System Administrator

# ─── P. Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=text
REQUEST_ID_HEADER=x-request-id

# ─── Q. Mail SMTP ────────────────────────────────────────────────────────────
# Prod: dùng SMTP provider thật (vd Brevo: smtp-relay.brevo.com:587).
MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_user
MAIL_PASS=your_smtp_password
MAIL_FROM_NAME=CAPSTONE System
MAIL_FROM=no-reply@example.com
MAIL_TIMEOUT_MS=10000

# ─── R. Recording / FFmpeg (REC-002/005, #23) ────────────────────────────────
# Để mặc định 'ffmpeg'/'ffprobe' nếu có trong PATH; hoặc đặt đường dẫn tuyệt đối.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
RECORDING_STORAGE_PATH=./storage/recordings
# Khóa mã hóa password RTSP (AES-256-GCM). BẮT BUỘC, tối thiểu 32 ký tự.
# CẢNH BÁO: đổi key này = KHÔNG giải mã được password RTSP đã lưu trước đó.
RTSP_CRED_KEY=change_me_to_a_random_secret_min_32_chars

# ─── S. No-show / Early Vacancy ──────────────────────────────────────────────
# NSC-001 (#31): token nội bộ cho POST /internal/no-show-cases (fail-closed nếu rỗng).
NOSHOW_INTERNAL_TOKEN=change_me_internal_noshow_token
NO_SHOW_THRESHOLD_MINUTES=15
NO_SHOW_WARNING_GRACE_MINUTES=0
NO_SHOW_AUTO_RELEASE_GRACE_MINUTES=5
# Việc B (tái đánh giá 2026-08-21): số phút gia hạn khi bấm "Tôi vẫn đến" (snoozed)
NO_SHOW_CONFIRM_EXTENSION_MINUTES=10
NO_SHOW_ALERT_EMAIL_ENABLED=false
# Việc B (Hướng 2): secret RIÊNG ký link xác nhận "Tôi vẫn đến" trong email no-show —
# KHÁC GUEST_TOKEN_SECRET/AUTH_ACCESS_TOKEN_SECRET (lộ 1 chỗ không ảnh hưởng chỗ khác).
NO_SHOW_CONFIRM_LINK_SECRET=change_me_no_show_confirm_link_secret_at_least_16_chars
# EVD-001: ngưỡng early-vacancy (phút) + bật email cảnh báo trống sớm
EARLY_VACANCY_EMPTY_MINUTES=10
EARLY_VACANCY_MIN_REMAINING_MINUTES=15
EARLY_VACANCY_MIN_ELAPSED_MINUTES=10
EARLY_VACANCY_ALERT_EMAIL_ENABLED=false

# ─── T. IVSS Bridge (sidecar, IVS-001 #36) ───────────────────────────────────
# Base URL + shared token (2 chiều) + group + timeout (ms)
IVSS_BRIDGE_BASE_URL=http://localhost:8088
IVSS_BRIDGE_TOKEN=change_me_ivss_bridge_token
IVSS_DEFAULT_GROUP=1
IVSS_BRIDGE_TIMEOUT_MS=8000
# Push ảnh trước giờ họp (phút) + xóa ảnh sau khi họp kết thúc (grace, phút)
IVSS_SYNC_LEAD_MINUTES=15
IVSS_SYNC_GRACE_MINUTES=5
# Phương án c, phần 1: lưới an toàn TTL cho kho chân dung thường trực (portrait) —
# mapping 'synced' quá N ngày tự hạ về 'pending' để reconcilePortraits() enroll lại,
# phòng trường hợp szUID lệch trên thiết bị ngoài tầm track của BE. TTL dài vì đây
# chỉ là fallback cuối, không phải cơ chế chính (dùng POST /admin/ivss/portrait/:userId/resync
# để force ngay khi có báo cáo cụ thể).
IVSS_PORTRAIT_TTL_DAYS=21

# ─── U. Face Access ──────────────────────────────────────────────────────────
# FGC-001: timeout call FaceGate (ms) + tz + field upload ảnh
FACEGATE_TIMEOUT_MS=8000
FACEGATE_TZ=Asia/Ho_Chi_Minh
FACEGATE_UPLOAD_FIELD=vfileselector
# FPE-001: giới hạn kích thước ảnh chân dung enroll (bytes, 5MB) — dùng chung cho avatar
FACE_PORTRAIT_MAX_BYTES=5242880
# FMP-001: per-meeting face provisioning (cron gated OFF theo mặc định)
FACE_SYNC_ENABLED=false
FACE_SYNC_LEAD_MINUTES=5
FACE_SYNC_GRACE_MINUTES=5
# FAT-001: grace (phút) phân loại late khi điểm danh bằng khuôn mặt
ATTENDANCE_LATE_GRACE_MINUTES=0
# DCO-001: giá trị info.Direction = RA (check-out). Giả định 2=out/1=in — xác nhận live trước production
FACE_DIRECTION_OUT_VALUE=2
# UMR-001: cửa sổ (phút) lấy verify gần đây cho danh sách unmapped (mặc định 24h)
FACE_UNMAPPED_WINDOW_MINUTES=1440
# SAL-001 (#20): cảnh báo stranger — throttle (giây/device), window list (phút), email opt-in
STRANGER_ALERT_THROTTLE_SECONDS=300
STRANGER_ALERT_WINDOW_MINUTES=1440
STRANGER_ALERT_EMAIL_ENABLED=false
# FAT-001: debug log payload verify callback (chỉ dùng khi soi cam)
FACE_VERIFY_DEBUG=false

# ─── V. Cloudinary (avatar / face submission) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_AVATAR_FOLDER=avatars

# ─── W. Media Download / Internal API ────────────────────────────────────────
# Signed download token (tối thiểu 16 ký tự) + public base URL
MEDIA_DOWNLOAD_TOKEN_SECRET=change_me_download_secret_at_least_16_characters
MEDIA_DOWNLOAD_TOKEN_TTL_SECONDS=600
API_PUBLIC_BASE_URL=http://localhost:3000
# Key bảo vệ internal endpoint (callback Python Camera Service / Door Terminal), >= 32 ký tự ở prod
INTERNAL_API_KEY=change_me_internal_api_key
# IOT-014: active probe phát hiện camera offline
DEVICE_OFFLINE_DETECT_ENABLED=true
RTSP_PROBE_TIMEOUT_MS=3000

# ─── X. AI Worker / AI Minutes ───────────────────────────────────────────────
# Việc #4 (2026-07-29): bật/tắt việc instance này có tự đăng ký xử lý job
# queue 'transcription' hay không. Mặc định 'true' (giữ nguyên hành vi cũ) —
# chỉ đặt 'false' trên instance KHÔNG được phép tự chạy STT (VD: EC2 khi
# worker thật chạy trên máy cá nhân qua Tailscale), tránh 2 instance cùng
# giành job trên cùng queue.
TRANSCRIPTION_WORKER_ENABLED=true
# AI Worker (offline transcription pipeline) — đọc qua process.env khi spawn worker.
# Chạy "npm run build" trong workers/ai-transcription trước khi start backend.
AI_PROFILE=local
WHISPER_MODEL=medium
TRANSCRIPTION_PROVIDER=local_faster_whisper
AI_WORKER_JOB_RUNNER_PATH=./workers/ai-transcription/dist/transcription-job-runner.js
AI_WORKER_JOB_TIMEOUT_MS=900000
# AI Summary (MKM-AI-01): LLM self-hosted (Ollama) trong private network — KHÔNG trỏ external.
# Feature flag/model cấu hình qua system_configs key "ai.minutes_summary", không qua env.
AI_SUMMARY_LLM_BASE_URL=http://localhost:11434
AI_SUMMARY_LLM_TIMEOUT_MS=900000
